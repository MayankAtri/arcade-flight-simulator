# Create a public access token at https://ion.cesium.com/tokens
# Restrict it to the Cesium assets used by this app and your deployment domains.
VITE_CESIUM_ION_TOKEN=

# One-shot visual evaluation only. Keep false during normal development and
# deployment so Google Photorealistic root-tile quota cannot be consumed.
VITE_ENABLE_PHOTOREALISTIC_EVALUATION=false

# Optional direct Google API key. The one-shot ion photorealistic evaluation
# intentionally does not use this; production remains Cesium-first.
VITE_GOOGLE_MAP_TILES_KEY=
